{# Featured posts configuration #}
{% set featured_enabled = theme_var('featuredposts') ? theme_var('featuredposts') : true %}
{% set featuredposts_number = theme_var('featuredposts_number') ? theme_var('featuredposts_number') : 3 %}

{% if featured_enabled and page.template == 'blog' %}
{# Get ALL children, not limited by content.limit, ya ordenados por fecha descendente #}
	{% set all_posts = page.children.order('date', 'desc') %}
	{% set featured_posts = [] %}
	{% for post in all_posts %}
		{% if post.header.featured %}
			{% set featured_posts = featured_posts|merge([post]) %}
		{% endif %}
	{% endfor %}
	{% if featured_posts|length > 0 %}
	<div class="sidebar-content">
		<h4>{{ 'DELIVERNEXT.SIDEBAR.FEATURED_POSTS'|t }}</h4>
		<div class="featured-posts">
			{% for post in featured_posts|slice(0, featuredposts_number) %}
				{% set post_image = post.media.images[post.header.featured_image] ?? post.media.images|first %}
				{% if post.taxonomy.category is not null %}
					<div class="featured-item">
						{% if post_image is not empty %}
							<div class="featured-image">
								<a class="image" aria-label="{{ post.title }}" href="{{ post.url }}">
									{{ post_image.loading('lazy').decoding('async').html|raw }}
								</a>
							</div>
						{% endif %}
						<div class="featured-content {% if post_image is empty %}full-width{% endif %}">
							<a href="{{ post.url }}" title="{{ post.title }}" rel="nofollow">{{ post.title }}</a>
							<small class="published">
								{{ 'DELIVERNEXT.MISC.IN'|t }} <span class="catlist">
								{% for category in post.taxonomy.category %}
									<a href="{{ base_url }}/category{{ config.system.param_sep }}{{ category }}">{{ category|raw }}</a>{% if not loop.last %}<span class="sep">, </span>{% endif %}
								{% endfor %}
								</span>
							</small>
						</div>
					</div>
				{% endif %}
			{% endfor %}
		</div>
	</div>
	{% endif %}
{% endif %}
