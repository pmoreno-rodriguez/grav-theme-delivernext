{% set intl_available = config.plugins.intl.enabled|default(false) %}

<ul class="archives">
{% for month,items in archives_data %}
    <li>
        <a href="{{ archives_url ?? base_url }}/{{ config.plugins.archives.taxonomy_names.month }}{{ config.system.param_sep }}{{ month|date(config.plugins.archives.taxonomy_values.month)|lower|e('url') }}">
            <span class="archive_date">
                {% if intl_available %}
                    {% include 'partials/sidebar/archives-intl.html.twig' %}
                {% else %}
                    {% include 'partials/sidebar/archives-fallback.html.twig' %}
                {% endif %}
            </span>
        </a>
        {% if archives_show_count %}
        <span>({{ items|length }})</span>
        {% endif %}
    </li>
{% endfor %}
</ul>
