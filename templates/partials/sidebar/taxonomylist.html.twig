{% set taxlist = children_only is defined ? taxonomylist.getChildPagesTags(of_page, children_only) : taxonomylist.get() %}

{% if taxlist and taxlist[taxonomy] is defined %}
{% set tags = filterend is defined ? taxlist[taxonomy]|slice(0, filterend, true) : taxlist[taxonomy] %}

<ul class="archives">
    {% for tax,value in tags %}
    <li>
        <a href="{{ base_url }}/{{ taxonomy }}{{ config.system.param_sep }}{{ tax }}">{{ tax }} </a>
    </li>
    {% endfor %}
</ul>
{% endif %}