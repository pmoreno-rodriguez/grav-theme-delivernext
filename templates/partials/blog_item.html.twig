{# Date Published #}
{% set datePublished = include('partials/page/date.html.twig') %}

<div class="list-item">

    <div class="list-blog-header">
        {% if showImage and image %}
            {% if big_header %}
                {{ image.cropResize(900,600).loading('lazy').decoding('async').html(page_title,page_title,'')|raw }}
            {% else %}
                {{ image.cropZoom(900,300).loading('lazy').decoding('async').html(page_title,page_title,'')|raw }}
            {% endif %}
        {% endif %}

        <h4>
            {% if truncate %}<a href="{{ page.url }}">{% endif %}
                {{ page.title }}
            {% if truncate %}</a>{% endif %}
        </h4>

        {% set item_external_url = page.header.item_external_url ?? page.header.link %}
        {% set item_external_text = page.header.item_external_text %}

        {% if not truncate and item_external_url %}
        <div class="item-external-url">
            <a href="{{ item_external_url }}"
               target="_blank"
               rel="noopener noreferrer"
               class="original-article-link">
                <i class="fa fa-link"></i>
                {{ item_external_text ?? 'External Link' }}
            </a>
        </div>
        {% endif %}

        <span class="list-blog-date">
            <i class="fa fa-calendar"></i>
            {{ datePublished }}
        </span>
        {% if page.header.author %}
        <span class="list-blog-author">
            <i class="fa fa-user"></i>
            {{ page.header.author }}
        </span>
        {% endif %}
       {% if page.taxonomy.tag %}
        <ul class="tags">
            <i class="fa fa-tag"></i>
            {% for tag in page.taxonomy.tag %}
            <li><a href="{{ base_url }}/tag{{ config.system.param_sep }}{{ tag }}">{{ tag }}</a></li>
            {% endfor %}
        </ul>
        {% endif %}

    </div>

    <div class="list-blog-padding">

    {% if truncate and summary_enabled %}
        {# Blog list: summary enabled - show truncated summary #}
        {% if page.summary != page.content %}
            {{ page.summary|raw }}
        {% else %}
            {# Use summary.size for truncate if no delimiter #}
            {{ page.content|truncate(summary_size)|raw }}
        {% endif %}
        {% if page.header.continue_link ?? true %}<p><a href="{{ page.url }}" class="button-outline">{{ 'DELIVERNEXT.BLOG.CONTINUE_READING'|t }}</a></p>{% endif %}
    {% elseif truncate %}
        {# Blog list: summary disabled - show only metadata (title, date, author, tags) #}
        {# Metadata is already displayed above, no extra content here #}
        {% if page.header.continue_link ?? true %}<p><a href="{{ page.url }}" class="button-outline">{{ 'DELIVERNEXT.BLOG.CONTINUE_READING'|t }}</a></p>{% endif %}
    {% else %}
       {# Individual article page #}
       {% if show_summary and summary_enabled %}
           {# Show extra summary before full content #}
           <div class="page-summary">
               {% if page.summary != page.content %}
                   {{ page.summary|raw }}
               {% else %}
                   {{ page.content|truncate(summary_size)|raw }}
               {% endif %}
           </div>
       {% endif %}
       {# Show full content #}
       {{ page.content|raw }}
       {% set show_prev_next = true %}
    {% endif %}

    {% if show_prev_next %}

        <p class="prev-next">
            {% if not page.isLast %}
                <a class="button" href="{{ page.prevSibling.url }}"><i class="fa fa-chevron-left"></i> {{ 'DELIVERNEXT.BLOG.PAGINATION.PREV'|t }}</a>
            {% endif %}

            {% if not page.isFirst %}
                <a class="button" href="{{ page.nextSibling.url }}">{{ 'DELIVERNEXT.BLOG.PAGINATION.NEXT'|t }} <i class="fa fa-chevron-right"></i></a>
            {% endif %}
        </p>
    {% endif %}

    </div>
</div>
