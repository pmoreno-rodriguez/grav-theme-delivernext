{% set logo_mobile = theme_var('theme_logo_mobile') %}
{% set logo_theme = theme_var('theme_logo') %}
{% set logo = logo_mobile is not null ? logo_mobile : logo_theme %}
{% set logoImageHeader = theme_var('type_logo_header') %}
{% set logoImageHeader = logoImageHeader is null ? 'text' : logoImageHeader %}
{% set first_logo = logo|first %}
{% set logo_file = (first_logo and first_logo.name) ? first_logo.name : null %}

<div class="logo">
    <a href="{{ home_url }}">
    {% if logoImageHeader == 'image' %}
        {% if logo_file %}<img src="{{ url('theme://images/logo/' ~ logo_file) }}" alt="{{ site.title|e('html_attr') }}" />{% endif %}
    {% elseif logoImageHeader == 'both' %}
    {% if logo_file %}<img src="{{ url('theme://images/logo/' ~ logo_file) }}" alt="{{ site.title|e('html_attr') }}" />{% endif %}
        <h3>{{ site.title }}</h3>
    {% else %}
        <h3>{{ site.title }}</h3>
    {% endif %}
    </a>
    {% if social %}
        {% block social %}
            {% include 'partials/social.html.twig' %}
        {% endblock %}
    {% endif %}
</div>
