{# FAVICON #}
{% set favicon = theme_var('favicon') %}
{% if favicon %}
    {% set favicon_data = favicon|first %}
    <link rel="icon" href="{{ url('theme://images/' ~ favicon_data.name) }}" type="{{ favicon_data.type }}">
{% else %}
    {% set default_favicon = 'favicon.png' %}
    <link rel="icon" type="image/png" href="{{ url('theme://images/' ~ default_favicon) }}" />
{% endif %}